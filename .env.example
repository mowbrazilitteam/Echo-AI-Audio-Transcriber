# Echo-AI works with no configuration. Copy to .env only what you want to change (it is read from the working folder).
# ECHO_PORTA=8765                     # local port (the app only listens on 127.0.0.1)
# ECHO_PASTA_DADOS=/path/to/folder    # where audio, transcripts and history are stored
# ECHO_WHISPER_MODELO=small           # default transcription model
# ECHO_WHISPER_DISPOSITIVO=auto       # auto | cuda | cpu
# ECHO_WHISPER_PRECISAO=auto          # auto | float16 | int8
# ECHO_OLLAMA_URL=http://127.0.0.1:11434
# ECHO_OLLAMA_MODELO=qwen2.5:7b       # empty = the AI recommended for this computer
# ECHO_MINUTOS_PARA_LIBERAR_A_PLACA=3 # the GPU is released after this many idle minutes
